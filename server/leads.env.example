# Настройки сервиса заявок.
#
# Скопировать в /etc/kleomed/leads.env и закрыть от посторонних:
#   install -d -m 750 /etc/kleomed
#   chmod 600 /etc/kleomed/leads.env
#
# В git этот файл с настоящими значениями не попадает — только этот образец.

# Слушаем только localhost: наружу сервис смотрит через nginx, который
# делает HTTPS. Открывать порт в мир нельзя — данные пойдут открытым текстом.
KLEOMED_HOST=127.0.0.1
KLEOMED_PORT=8081

# База заявок. Каталог создаёт systemd через StateDirectory.
KLEOMED_DB=/var/lib/kleomed/leads.db

# --- Битрикс24 ---------------------------------------------------------
# Куда уходят заявки. Адрес входящего вебхука из портала:
#   Приложения → Разработчикам → Другое → Входящий вебхук,
#   право «CRM (crm)», кнопка «Сохранить» — вебхук появится в списке.
# Выглядит так:
#   https://ваш-портал.bitrix24.ru/rest/1/xxxxxxxxxxxxxxxx/
#
# Этот адрес равносилен паролю от CRM: кто его знает, тот читает и пишет
# карточки. Поэтому он живёт только здесь, файл закрыт chmod 600, и в git
# не попадает. Утёк — удалите вебхук в портале и создайте новый.
#
# Пока пусто, заявки принимаются и копятся в базе, но в CRM не уходят.
KLEOMED_B24_HOOK=

# Что заводить: lead (лид) или deal (контакт + сделка).
# Новые порталы Битрикс создаёт в «простом режиме», где лидов нет вообще —
# там нужен deal. Если в левом меню CRM есть раздел «Лиды», оставляйте lead.
KLEOMED_B24_ENTITY=lead

# Кого назначить ответственным (id сотрудника в портале). Пусто — Битрикс
# распределит сам по своим правилам.
KLEOMED_B24_ASSIGNED=

# Источник из справочника CRM. WEB — «Сайт», есть на любом портале.
KLEOMED_B24_SOURCE=WEB

# --- IDENT (не используется) -------------------------------------------
# Клиника выбрала Битрикс24, но точки опроса остались на месте. Пустой ключ
# держит /GetTickets закрытым: лучше явные 503, чем открытая наружу выдача
# заявок. Понадобится IDENT — сюда длинную случайную строку, ту же, что
# в его настройках:
#   openssl rand -hex 32
KLEOMED_IDENT_KEY=

# Токен страницы со списком заявок: /admin?token=...
# Нужен, пока IDENT не подключён — администратору где-то надо видеть телефон.
#   openssl rand -hex 24
KLEOMED_ADMIN_TOKEN=

# MAX — российский мессенджер. Бот создаётся у @MasterBot командой /create,
# он же выдаёт токен. Дальше узнаём, КУДА писать: впишите токен, напишите
# боту в MAX любое сообщение и запустите на сервере
#     python3 /opt/kleomed/leads.py --chats
# Команда подождёт вашего сообщения и напечатает chat_id.
KLEOMED_MAX_TOKEN=
KLEOMED_MAX_CHAT=

# Что уходит в сообщении. По умолчанию (1) — имя, телефон, услуга, пожелание
# по времени и страница: чтобы перезвонить, не открывая IDENT.
# Поставьте 0, если решите оставить только «пришла заявка №142».
#
# Важно: при 1 переписка бота — ещё одно место, где лежат данные пациентов.
# Факт обращения к стоматологу составляет врачебную тайну (323-ФЗ ст. 13),
# поэтому чат должен быть ЛИЧНЫМ чатом владельца, а не общей группой.
KLEOMED_MAX_DETAILS=1

# Корневой сертификат УЦ Минцифры для проверки TLS у API MAX: в хранилище
# Ubuntu его нет. Применяется только к MAX, остальное ходит по системному.
# Лежит в /opt/kleomed, а НЕ в /etc/kleomed: каталог с секретами закрыт
# режимом 750 root:root, и сервис под пользователем kleomed файл оттуда
# не прочитает — получите «MAX не ответил: [Errno 13] Permission denied».
# Обновить, когда истечёт (действует до 2032-02-27):
#     curl -o /opt/kleomed/max-ca.pem \
#          https://gu-st.ru/content/lending/russian_trusted_root_ca_pem.crt
# Пусто — используется системное хранилище, и для MAX это не сработает.
KLEOMED_MAX_CA=/opt/kleomed/max-ca.pem

# Адрес API. Менять только если MAX сменит домен.
KLEOMED_MAX_API=https://platform-api2.max.ru
